rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {


    // USERS

    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }


    // TUTORS

    match /tutors/{tutorId} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
                    && request.auth.uid == tutorId;
    }


    // BOOKINGS

    match /bookings/{bookingId} {
      allow read: if request.auth != null
                  && (
                    resource.data.studentId == request.auth.uid ||
                    resource.data.tutorId == request.auth.uid
                  );

      allow create: if request.auth != null
                   && request.resource.data.studentId == request.auth.uid;

      // Either party can update (accept/decline/mark paid/etc), but
      // neither can change WHO the booking belongs to after creation.
      allow update: if request.auth != null
                   && (
                     resource.data.studentId == request.auth.uid ||
                     resource.data.tutorId == request.auth.uid
                   )
                   && request.resource.data.studentId == resource.data.studentId
                   && request.resource.data.tutorId == resource.data.tutorId;

      // Students can only cancel bookings that are still pending —
      // once a tutor has accepted it, it becomes real session history
      // and shouldn't disappear. Use a 'cancelled' status update instead.
      allow delete: if request.auth != null
                   && resource.data.studentId == request.auth.uid
                   && resource.data.status == 'pending';
    }


    // REVIEWS

    match /reviews/{reviewId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.studentId == request.auth.uid;

      // Reviews are a permanent record once posted — no edits or
      // deletes by anyone, including the student who wrote it, so a
      // rating can't be quietly changed after the fact.
      allow update, delete: if false;
    }


    // TRANSACTIONS
    // Financial records. Client never writes these directly — they
    // should only ever be created by a trusted backend (Cloud Function)
    // when a payment is actually confirmed. Reads limited to the two
    // people involved.
    match /transactions/{transactionId} {
      allow read: if request.auth != null
                  && (
                    resource.data.studentId == request.auth.uid ||
                    resource.data.tutorId == request.auth.uid
                  );
      allow write: if false;
    }


    // Deny everything else by default — protects any collection
    // that isn't explicitly handled above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
